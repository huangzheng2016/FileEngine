# FileEngine docker test environment — copy to .env and fill in real values.
# .env is gitignored; NEVER commit real keys/addresses.
#
# Used by: docker-compose.yml (interpolation) and bootstrap.sh (host-side
# one-shot provisioning of the filesystem + model provider via the API).

# Host port the UI/API is published on (container always listens on 8080).
FE_PORT=8080

# --- Agent tuning (written into /data/config.yaml on first start) ----------
FE_AGENT_CONCURRENCY=1
FE_AGENT_BATCH_SIZE=50
FE_AGENT_MAX_STEP=150
FE_AGENT_MAX_RETRIES=3
FE_AGENT_MAX_FILE_READ_SIZE=102400

# --- Filesystem provisioned by bootstrap.sh --------------------------------
FE_FS_NAME=nfs-test
FE_FS_PROTOCOL=nfs
# Use the LAN IP when the docker host can reach the NAS directly (Linux docker
# or a bridge network). On macOS Docker Desktop/OrbStack, containers cannot
# reach LAN hosts — use the NAS's Tailscale IP instead (e.g. 100.x.x.x) if
# available, or run the stack on a host with LAN access.
FE_FS_HOST=192.168.1.x
FE_FS_PORT=2049
# Export path (+ optional sub-path), e.g. /fs/1000/nfs
FE_FS_BASE_PATH=/export/path

# --- Optional: SMB backend on the same NAS (dual-protocol cross-check) ------
# fnOS exposes each top-level folder as its own share (list with
# `smbutil view //user:pass@host`); provision via the UI or API like the NFS one.
# FE_SMB_NAME=smb-sharespace
# FE_SMB_HOST=100.x.x.x
# FE_SMB_PORT=445
# FE_SMB_USER=your-user
# FE_SMB_PASSWORD=your-password
# FE_SMB_BASE_PATH=ShareSpace

# --- Model provider provisioned by bootstrap.sh ----------------------------
FE_MODEL_NAME=kimi-k3
FE_MODEL_PROVIDER=openai
FE_MODEL_BASE_URL=https://your-openai-compatible-endpoint/v1
FE_MODEL_API_KEY=replace-with-real-key
FE_MODEL_MODEL=kimi-k3-0813
FE_MODEL_CONTEXT_WINDOW=1048576
FE_MODEL_MAX_TOKENS=8192
# kimi-k3 is a reasoning model: the sampler is locked and only temperature=1
# is accepted — keep 1 for it, use your own model's default otherwise.
FE_MODEL_TEMPERATURE=1
FE_MODEL_VISION_ENABLED=false

# bootstrap.sh: after provisioning, verify both connections (1=yes, 0=no).
FE_BOOTSTRAP_TEST=1
